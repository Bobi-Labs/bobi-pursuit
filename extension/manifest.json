{
  "manifest_version": 3,
  "name": "Bobi-Pursuit — Capture",
  "version": "0.1.0",
  "description": "Capture the job you're viewing into your Bobi-Pursuit board, scored on the spot. Only when you click. No background crawling, no account.",
  "homepage_url": "https://pursuit.bobilabs.dev",
  "permissions": ["sidePanel", "scripting", "storage", "tabs"],
  "optional_permissions": ["cookies"],
  "host_permissions": ["<all_urls>"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Bobi-Pursuit — open capture panel",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": { "default_path": "sidepanel.html" },
  "options_page": "options.html"
}
